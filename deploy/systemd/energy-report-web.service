# Sample systemd unit template for the optional Web GUI deployment.
# The installer renders these placeholders:
# - __SERVICE_USER__
# - __PROJECT_ROOT__
# - __WEB_HOST__
# - __WEB_PORT__

[Unit]
Description=Energy Report Web GUI
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_USER__
WorkingDirectory=__PROJECT_ROOT__
ExecStart=__PROJECT_ROOT__/venv/bin/uvicorn src.web_app:app --host __WEB_HOST__ --port __WEB_PORT__
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
