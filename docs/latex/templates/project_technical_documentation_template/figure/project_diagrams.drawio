                <mxCell id="rfv_outputs" value="HTML view    |    PDF source + PDF    |    Daily Excel workbook" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=14;fontStyle=1;fontColor=#475569;align=center;verticalAlign=middle;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="210" y="1122" width="480" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="rfv_s1" value="1. Bootstrap runtime&lt;br&gt;&lt;b&gt;config, MySQL client, repositories, runtime logging&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#EAF3FB;gradientColor=#FFFFFF;strokeColor=#7FAAC8;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=82;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="220" y="157" width="460" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="rfv_s2" value="2. Resolve periods&lt;br&gt;&lt;b&gt;anchor date, report types, canonical export stems&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F8FAFC;gradientColor=#FFFFFF;strokeColor=#94A3B8;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=82;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="220" y="280" width="460" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="rfv_s3" value="3. Fetch source rows&lt;br&gt;&lt;b&gt;energy_kpi, utility usage, area energy, selected sensors&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ECF7EE;gradientColor=#FFFFFF;strokeColor=#5EA46A;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=82;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="220" y="404" width="460" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="rfv_s4" value="4. Aggregate sensor statistics&lt;br&gt;&lt;b&gt;min, average, max, monitoring structures&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ECF7EE;gradientColor=#FFFFFF;strokeColor=#5EA46A;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=82;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="220" y="522" width="460" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="rfv_s5" value="5. Build domain objects&lt;br&gt;&lt;b&gt;Electricity, KPI, Utility blocks with rules applied&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#EAF3FB;gradientColor=#FFFFFF;strokeColor=#7FAAC8;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=82;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="220" y="643" width="460" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="rfv_s6" value="6. Assemble report_context&lt;br&gt;&lt;b&gt;meta, sections, flags, labels, notes, presentation tokens&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF4E2;gradientColor=#FFFFFF;strokeColor=#C58B2B;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=82;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="220" y="764" width="460" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="rfv_s7" value="7. Render and export artifacts&lt;br&gt;&lt;b&gt;view_html, pdf_source_html, PDF, daily Excel&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF4E2;gradientColor=#FFFFFF;strokeColor=#C58B2B;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=82;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="220" y="883" width="460" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="rfv_s8" value="8. Store canonical outputs&lt;br&gt;&lt;b&gt;OUTPUT_DIR/YYYY_MM/ with monthly, weekly, daily prefixes&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F8FAFC;gradientColor=#FFFFFF;strokeColor=#94A3B8;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=82;shadow=1;" parent="1" vertex="1">
