    <diagram id="report-flow-vertical-icons" name="Report Flow - Vertical Icons">
        <mxGraphModel dx="833" dy="588" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1500" math="0" shadow="0">
