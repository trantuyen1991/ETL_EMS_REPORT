<mxfile host="65bd71144e">
    <diagram id="system-architecture" name="System Architecture">
        <mxGraphModel dx="656" dy="348" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1280" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="sa_title" value="ENERGY REPORTING SYSTEM ARCHITECTURE" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=28;fontStyle=1;fontColor=#1F2937;" parent="1" vertex="1">
                    <mxGeometry x="80" y="36" width="1240" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="sa_subtitle" value="Current project runtime, data ownership, report context, and artifact flow" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#6B7280;" parent="1" vertex="1">
                    <mxGeometry x="160" y="78" width="1080" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="sa_note" value="Daily run orchestration in main.py. Weekly runs are added on Sunday; monthly runs are added at month-end." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#94A3B8;fontSize=12;fontColor=#6B7280;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="230" y="120" width="940" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="sa_runtime_body" value="main.py loads config, logging,&lt;br&gt;and MySQL access.&lt;br&gt;PeriodService resolves run periods&lt;br&gt;and canonical output naming." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EAF3FB;strokeColor=#94A3B8;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacingTop=26;" parent="1" vertex="1">
                    <mxGeometry x="120" y="220" width="430" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="sa_runtime_header" value="Runtime and Configuration Inputs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#005496;strokeColor=#005496;fontSize=15;fontStyle=1;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=14;" parent="1" vertex="1">
                    <mxGeometry x="120" y="220" width="430" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="sa_source_body" value="total_energy owns Electricity official totals;&lt;br&gt;energy_kpi owns KPI values and&lt;br&gt;production rows.&lt;br&gt;Utility and sensor sources feed&lt;br&gt;detail, monitoring, and checks." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ECF7EE;strokeColor=#94A3B8;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacingTop=26;" parent="1" vertex="1">
                    <mxGeometry x="850" y="220" width="430" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="sa_source_header" value="Source Data Ownership" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#2E7D32;strokeColor=#2E7D32;fontSize=15;fontStyle=1;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=14;" parent="1" vertex="1">
                    <mxGeometry x="850" y="220" width="430" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="sa_repo_body" value="Repositories read energy, KPI, utility, and sensor rows&lt;br&gt;for current and previous comparison windows." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F3F4F6;strokeColor=#94A3B8;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacingTop=26;" parent="1" vertex="1">
                    <mxGeometry x="120" y="440" width="1160" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="sa_repo_header" value="Repository Layer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#4B5563;strokeColor=#4B5563;fontSize=15;fontStyle=1;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=14;" parent="1" vertex="1">
                    <mxGeometry x="120" y="440" width="1160" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="sa_service_body" value="Business services apply KPI coverage, official totals, comparisons,&lt;br&gt;Top 10 rules, utility statistics, and monitoring context.&lt;br&gt;ReportStyleService injects presentation tokens from report_style.json." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EAF3FB;strokeColor=#94A3B8;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacingTop=26;" parent="1" vertex="1">
                    <mxGeometry x="120" y="600" width="1160" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="sa_service_header" value="Service Layer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#005496;strokeColor=#005496;fontSize=15;fontStyle=1;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=14;" parent="1" vertex="1">
                    <mxGeometry x="120" y="600" width="1160" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="sa_context_body" value="ReportBuilderService.build_report_context_v3&lt;br&gt;creates meta, periods, summaries, flags, labels, notes, and domain sections." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF4E2;strokeColor=#94A3B8;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacingTop=26;" parent="1" vertex="1">
                    <mxGeometry x="330" y="790" width="740" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="sa_context_header" value="Unified report_context" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#B26A00;strokeColor=#B26A00;fontSize=15;fontStyle=1;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=14;" parent="1" vertex="1">
                    <mxGeometry x="330" y="790" width="740" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="sa_artifact_note" value="Artifacts are grouped by month&lt;br&gt;and then split by output type." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#6B7280;" parent="1" vertex="1">
                    <mxGeometry x="820" y="916" width="280" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="sa_render_body" value="Renders view_html and&lt;br&gt;pdf_source_html.&lt;br&gt;PDFService prints staging HTML." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EAF3FB;strokeColor=#94A3B8;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacingTop=26;" parent="1" vertex="1">
                    <mxGeometry x="120" y="980" width="430" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="sa_render_header" value="Rendering Path" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#005496;strokeColor=#005496;fontSize=15;fontStyle=1;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=14;" parent="1" vertex="1">
                    <mxGeometry x="120" y="980" width="430" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="sa_excel_body" value="Builds the daily workbook only.&lt;br&gt;Sheets derive from stable tables&lt;br&gt;in report_context." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ECF7EE;strokeColor=#94A3B8;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacingTop=26;" parent="1" vertex="1">
                    <mxGeometry x="850" y="980" width="430" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="sa_excel_header" value="Excel Export Path" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#2E7D32;strokeColor=#2E7D32;fontSize=15;fontStyle=1;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=14;" parent="1" vertex="1">
                    <mxGeometry x="850" y="980" width="430" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="sa_canonical_body" value="OUTPUT_DIR/YYYY_MM/ stores HTML, PDF, and Excel artifacts.&lt;br&gt;If blank, runtime falls back to output/reports/YYYY_MM/." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F3F4F6;strokeColor=#94A3B8;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacingTop=26;" parent="1" vertex="1">
